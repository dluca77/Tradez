# Copy to .env and fill in real values. Never commit .env.

# --- Broker credentials (choose the one matching config.yaml broker.name) ---

# MetaTrader 5 (requires an MT5 terminal installed on this host — native on
# Windows, or via Wine elsewhere. Not available on plain Linux.)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_SYMBOL_SUFFIX=
# Per-symbol name overrides for brokers with no consistent naming (e.g. a
# MetaQuotes demo server lists Nasdaq 100 as "USTEC" and S&P 500 as "US500").
# Check your MT5 Market Watch (Symbols search) for the exact names.
# Format: comma-separated KEY=VALUE pairs, e.g.:
# MT5_SYMBOL_OVERRIDES=NAS100=USTEC,SPX500=US500
MT5_SYMBOL_OVERRIDES=

# OANDA
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENV=practice

# Interactive Brokers
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1

# --- News / economic calendar provider ---
NEWS_API_KEY=

# --- Notifications ---
NOTIFY_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL_TO=

# --- App ---
TRADINGBOT_ENV=development
